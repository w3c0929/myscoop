            "hash": "sha256:aac4cacb62d2f853fdae514931b25c484f54a007009dd5fcb09d5b657a7678c9"
        },
        "64bit": {
            "url": "https://github.com/finchtoys/finch-releases/releases/download/v1.7.4/Finch-1.7.4-setup-x64.exe",
            "hash": "sha256:b586cf5bf1710f7160930d394f77987c628d858cee32c30f2afd998c29f8de5a"
        }
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://github.com/finchtoys/finch-releases/releases/download/v$version/Finch-$version-setup-ia32.exe"
            },
            "64bit": {
                "url": "https://github.com/finchtoys/finch-releases/releases/download/v$version/Finch-$version-setup-x64.exe"
            }
        }
    },
    "pre_install": [
        "Expand-7zipArchive (Get-ChildItem \"$dir\\*.exe\" | Select-Object -First 1).FullName \"$dir\\_extract\"",
        "$__app7z = Get-ChildItem \"$dir\\_extract\" -Recurse -Filter 'app-*.7z' | Select-Object -First 1",
        "if ($__app7z) { Expand-7zipArchive $__app7z.FullName \"$dir\"; Remove-Item \"$dir\\_extract\" -Recurse -Force } else { Move-Item \"$dir\\_extract\\*\" \"$dir\" -Force; Remove-Item \"$dir\\_extract\" -Recurse -Force }"
    ],
    "bin": "Finch.exe",
    "shortcuts": [
        [
            "Finch.exe",
            "Finch"
        ]
    ]
}
