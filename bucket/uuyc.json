    "pre_install": [
        "Expand-7zipArchive (Get-ChildItem \"$dir\\*.exe\" | Select-Object -First 1).FullName \"$dir\\_extract\"",
        "$sub = Get-ChildItem \"$dir\\_extract\" -Directory | Where-Object { $_.Name -like '*37*' } | Select-Object -First 1",
        "if ($sub) { Move-Item \"$($sub.FullName)\\*\" \"$dir\" -Force } else { Move-Item \"$dir\\_extract\\*\" \"$dir\" -Force }",
        "Remove-Item \"$dir\\_extract\" -Recurse -Force"
    ],
    "bin": "GameViewer.exe",
    "shortcuts": [
        [
            "GameViewer.exe",
            "网易UU远程"
        ]
    ],
    "checkver": {
        "url": "https://api.nrd.nie.163.com/api/v1/release/dl-infos?channel=gwqd",
        "regex": "\"1\":\\s*\\{[^}]*?\"version_name\":\\s*\"([\\d.]+)\""
    },
    "autoupdate": {
        "url": "https://api.nrd.nie.163.com/api/v1/release/dl/1?channel=gwqd#/uuyc-setup.exe"
    },
    "notes": [
        "免安装便携版：NSIS 安装包用 7z 解包后拍平载荷目录（$dir 根为程序本体，主程序 GameViewer.exe）。",
        "自动更新：checkver 读取官方 dl-infos 接口中 Windows（key=1）的稳定版本号；autoupdate 走下载接口（302 到安装包）。",
        "下载接口在灰度发布期间可能随机返回新旧两个版本，稳定版以 dl-infos 的 key=1 为准。"
    ]
}
