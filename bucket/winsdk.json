    },
    "post_install": [
        "Start-Process -FilePath \"$dir\\windowsappruntimeinstall-x64.exe\" -ArgumentList '--quiet' -Wait"
    ],
    "notes": [
        "安装时自动执行 windowsappruntimeinstall-x64.exe --quiet，静默安装 Windows App Runtime（实测非管理员 exit 0）。",
