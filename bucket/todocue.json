{
    "version": "0.10.3",
    "description": "A local-first macOS task companion. Native Liquid Glass UI, CLI and MCP for your agents.",
    "homepage": "https://github.com/NanmiCoder/TodoCue",
    "license": "MIT",
    "checkver": {
        "github": "https://github.com/NanmiCoder/TodoCue"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/NanmiCoder/TodoCue/releases/download/v0.10.3/TodoCue-0.10.3-Windows-x64-setup.exe",
            "hash": "sha256:a2d8f6f2ff20bde1f401f1cd946a63613f1064d4af791203ec145e266e255105"
        },
        "arm64": {
            "url": "https://github.com/NanmiCoder/TodoCue/releases/download/v0.10.3/TodoCue-0.10.3-Windows-arm64-setup.exe",
            "hash": "sha256:ddd7d195cf2a78203baac577df4240c99c54e2b6ac4fcfa65b4b622e6ef0b97c"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/NanmiCoder/TodoCue/releases/download/v$version/TodoCue-$version-Windows-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/NanmiCoder/TodoCue/releases/download/v$version/TodoCue-$version-Windows-arm64-setup.exe"
            }
        }
    },
    "bin": "todocue-desktop.exe",
    "shortcuts": [
        [
            "todocue-desktop.exe",
            "todocue"
        ]
    ],
    "pre_install": [
        "Expand-7zipArchive (Get-ChildItem \"$dir\\*.exe\" | Select-Object -First 1).FullName \"$dir\\_extract\"",
        "$__app7z = Get-ChildItem \"$dir\\_extract\" -Recurse -Filter 'app-*.7z' | Select-Object -First 1",
        "if ($__app7z) { Expand-7zipArchive $__app7z.FullName \"$dir\"; Remove-Item \"$dir\\_extract\" -Recurse -Force } else { Move-Item \"$dir\\_extract\\*\" \"$dir\" -Force; Remove-Item \"$dir\\_extract\" -Recurse -Force }"
    ],
    "post_install": [
        "New-Item -Path 'HKCU:\\Software\\Classes\\AppUserModelId\\com.todocue.app' -Force | Out-Null",
        "Set-ItemProperty -Path 'HKCU:\\Software\\Classes\\AppUserModelId\\com.todocue.app' -Name DisplayName -Value 'TodoCue'",
        "& \"$dir\\todocue-cli.exe\" install --skip-apps | Out-Null"
    ],
    "pre_uninstall": [
        "& \"$dir\\todocue-cli.exe\" service stop 2>$null | Out-Null",
        "Get-Process todocue-desktop, todocue-runtime, node -ErrorAction SilentlyContinue | Where-Object { $_.Path -like \"$dir\\*\" } | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "uninstaller": {
        "script": [
            "Remove-Item 'HKCU:\\Software\\Classes\\AppUserModelId\\com.todocue.app' -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "suggest": {
        "Microsoft Edge WebView2 Runtime": [
            "webview2"
        ]
    }
}
