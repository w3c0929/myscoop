{
    "version": "4.1.0",
    "description": "Redefining the open-source download manager",
    "homepage": "https://rayburst.pages.dev",
    "license": "MIT",
    "checkver": {
        "github": "https://github.com/AnInsomniacy/rayburst"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.1.0/Rayburst_4.1.0_x64-setup.exe",
            "hash": "sha256:93d3fc70477ab70e627289ea4fab8c7901f4383e0f56eca81cc59c9ff9ce594a"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.1.0/Rayburst_4.1.0_arm64-setup.exe",
            "hash": "sha256:bb884e08baaed3ee8eeacbd2d6e7d888c59106967076f8e454c8a85526969ac5"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_arm64-setup.exe"
            }
        }
    },
    "bin": "rayburst.exe",
    "shortcuts": [
        [
            "rayburst.exe",
            "rayburst"
        ]
    ],
    "pre_install": [
        "Expand-7zipArchive (Get-ChildItem \"$dir\\*.exe\" | Select-Object -First 1).FullName \"$dir\\_extract\"",
        "$__app7z = Get-ChildItem \"$dir\\_extract\" -Recurse -Filter 'app-*.7z' | Select-Object -First 1",
        "if ($__app7z) { Expand-7zipArchive $__app7z.FullName \"$dir\"; Remove-Item \"$dir\\_extract\" -Recurse -Force } else { Move-Item \"$dir\\_extract\\*\" \"$dir\" -Force; Remove-Item \"$dir\\_extract\" -Recurse -Force }"
    ]
}
