        "regsvr32 /s \"$dir\\bdzshl64.dll\"",
        "$regRoot = 'HKCU:\\Software\\Classes'",
        "@('*\\ShellEx\\ContextMenuHandlers', '*\\ShellEx\\DragDropHandlers', 'Directory\\ShellEx\\ContextMenuHandlers', 'Directory\\ShellEx\\DragDropHandlers', 'Drive\\ShellEx\\ContextMenuHandlers', 'Directory\\Background\\ShellEx\\ContextMenuHandlers') | ForEach-Object { New-Item -Path \"$regRoot\\$_\\BZContextMenu\" -Force | Out-Null; Set-ItemProperty -Path \"$regRoot\\$_\\BZContextMenu\" -Name '(default)' -Value $guid }"
    ],
