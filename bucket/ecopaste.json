    "license": "Apache-2.0",
    "checkver": {
        "github": "https://github.com/EcoPasteHub/EcoPaste"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/EcoPasteHub/EcoPaste/releases/download/v1.1.0/EcoPaste_1.1.0_x64-setup.exe",
            "hash": "sha256:8a437d9f2cd960184942e0b1a2d1063566501928ead07cf82bc0959da534b5bf"
        },
        "arm64": {
            "url": "https://github.com/EcoPasteHub/EcoPaste/releases/download/v1.1.0/EcoPaste_1.1.0_arm64-setup.exe",
            "hash": "sha256:94a8efaf4fbb5b2be13f705da6da49a826d8e7efd2ff8f74fb88a12184d36f14"
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/EcoPasteHub/EcoPaste/releases/download/v$version/EcoPaste_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/EcoPasteHub/EcoPaste/releases/download/v$version/EcoPaste_$version_arm64-setup.exe"
            }
        }
    },
    "bin": "EcoPaste.exe",
    "shortcuts": [
        [
            "EcoPaste.exe",
            "ecopaste"
        ]
    ],
    "pre_install": [
        "Expand-7zipArchive (Get-ChildItem \"$dir\\*.exe\" | Select-Object -First 1).FullName \"$dir\\_extract\"",
        "$__app7z = Get-ChildItem \"$dir\\_extract\" -Recurse -Filter 'app-*.7z' | Select-Object -First 1",
        "if ($__app7z) { Expand-7zipArchive $__app7z.FullName \"$dir\"; Remove-Item \"$dir\\_extract\" -Recurse -Force } else { Move-Item \"$dir\\_extract\\*\" \"$dir\" -Force; Remove-Item \"$dir\\_extract\" -Recurse -Force }"
    ]
}
